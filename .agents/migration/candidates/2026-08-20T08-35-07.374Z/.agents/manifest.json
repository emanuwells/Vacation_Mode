{
  "name": "WELLS Agent Runtime",
  "version": "1.2.0",
  "entrypoint": ".agents/AGENTS.md",
  "prompt": "Lê .agents/AGENTS.md e <tarefa>.",
  "counts": {
    "skills": 59,
    "roles": 11,
    "policies": 20,
    "workflows": 11
  },
  "state": [
    ".agents/state/TODO.md",
    ".agents/state/HANDOFF.md",
    ".agents/state/LESSONS.md",
    ".agents/state/DECISIONS.md",
    ".agents/state/EVIDENCE.md"
  ],
  "managedRoots": [
    ".agents/core",
    ".agents/skills",
    ".agents/workflows",
    ".agents/roles",
    ".agents/policies",
    ".agents/ops",
    ".agents/mcp",
    ".agents/adapters",
    ".agents/handoffs",
    ".agents/templates",
    ".agents/extensions",
    ".agents/hooks",
    ".agents/setup",
    ".agents/tools",
    ".agents/knowledge",
    ".agents/integrations",
    ".agents/vendor",
    ".agents/evals"
  ],
  "contextPolicy": {
    "automatic": [],
    "canonicalOnDemand": [
      ".agents/AGENTS.md"
    ],
    "defaultMaxWorkflows": 1,
    "defaultMaxSkills": 2,
    "maxBootstrapWords": 140,
    "maxRuntimeWords": 650,
    "layers": {
      "core": [
        ".agents/AGENTS.md",
        "request",
        "direct-files"
      ],
      "onDemand": [
        "INDEX",
        "workflow",
        "skills",
        "roles",
        "policies",
        "state",
        "integrations"
      ],
      "evals": "never-during-normal-work"
    }
  },
  "canonicalRuntime": ".agents/AGENTS.md",
  "nativeEntrypoints": {},
  "universalSkillsPath": ".agents/skills",
  "claudeAdapter": {
    "plugin": ".agents/adapters/claude/plugin",
    "personalSkills": ".agents/adapters/claude/user-skills",
    "marketplaceTarget": "~/.wells-ai/claude-marketplace",
    "install": "claude plugin install wells-runtime@wells-ai"
  },
  "knowledgeGraph": {
    "root": ".agents/knowledge",
    "index": ".agents/knowledge/INDEX.md",
    "graph": ".agents/knowledge/GRAPH.json",
    "sources": ".agents/knowledge/SOURCES.yml"
  },
  "outputProfiles": {
    "automatic": [
      "headroom",
      "ponytail"
    ],
    "prose": [
      "humanizer",
      "stop-the-slop"
    ]
  },
  "modelRouting": {
    "policy": ".agents/core/MODEL_ROUTING.md",
    "profiles": [
      "free",
      "economical",
      "premium"
    ],
    "providerAgnostic": true
  },
  "evals": {
    "root": ".agents/evals",
    "tasks": 10,
    "scoring": ".agents/evals/SCORING.md"
  },
  "outputHygiene": {
    "policy": ".agents/policies/OUTPUT_HYGIENE_POLICY.md",
    "finalizer": ".agents/tools/wells-finalize.mjs",
    "mode": "safe-deterministic",
    "automaticClaudeStopHook": ".agents/extensions/hooks/safe-output-hygiene",
    "llmCalls": 0,
    "excludes": [
      "C2PA",
      "authorship metadata",
      "visual watermarks",
      "ZWJ/ZWNJ",
      "bidi controls"
    ]
  },
  "currentDocs": {
    "skill": ".agents/skills/context7-current-docs/SKILL.md",
    "integration": "context7-cli",
    "onDemand": true
  },
  "securityGate": {
    "skill": ".agents/skills/security-quality-gate/SKILL.md",
    "tool": ".agents/tools/security-gate.mjs",
    "automatic": false
  }
}
